# Renders and build caches stay out of git; source assets under businesses/*/assets/ are tracked.
businesses/*/videos/*/output/
businesses/*/videos/*/composition/node_modules/
businesses/*/videos/*/composition/.hyperframes/
businesses/*/videos/*/composition/render/
businesses/*/videos/*/composition/assets/music/
**/brag-output*/

